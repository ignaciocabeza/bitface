{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src/index.ts", "src/react.tsx", "src/vue.ts", "src/types.ts", "src/renderer/**/*"],
  "exclude": ["src/ui/**/*", "src/main.ts", "docs/**/*"]
}
